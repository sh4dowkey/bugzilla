{
  "manifest_version": 3,
  "name": "Bugzilla Counter",
  "version": "1.0.2",
  "description": "Counts bugs with status NEW and RESP on a Bugzilla bug-list tab and shows the counts on the tab favicon.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bugzilla-new-counter@inhouse.net",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "webNavigation",
    "notifications",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://cb.inhouse.net/*",
    "http://cb.inhouse.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bugzilla Counter",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
